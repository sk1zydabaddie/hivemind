diff --git a/test/email.test.js b/test/email.test.js
new file mode 100644
index 0000000..f5ec6c5
--- /dev/null
+++ b/test/email.test.js
@@ -0,0 +1,25 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { isValidEmail } from "../src/index.js";
+
+test("accepts a common email address", () => {
+  assert.equal(isValidEmail("person@example.com"), true);
+});
+
+test("rejects malformed addresses and non-string values", () => {
+  for (const value of [
+    "person",
+    "@example.com",
+    "person@",
+    "   ",
+    " person@example.com",
+    "person@example.com ",
+    null,
+    undefined,
+    42,
+    {},
+    [],
+  ]) {
+    assert.doesNotThrow(() => assert.equal(isValidEmail(value), false));
+  }
+});
