+++ b/src/email.js
@@ -0,0 +1,13 @@
+const EMAIL_PATTERN = /^(?:[A-Z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[A-Z0-9!#$%&'*+/=?^_`{|}~-]+)*)@(?:[A-Z0-9](?:[A-Z0-9-]{0,61}[A-Z0-9])?\.)+[A-Z0-9](?:[A-Z0-9-]{0,61}[A-Z0-9])?$/iu;
+
+/**
+ * Performs a local, practical syntax check for an email address.
+ *
+ * This intentionally does not verify DNS records or mailbox existence.
+ *
+ * @param {unknown} value
+ * @returns {boolean}
+ */
+export function isValidEmail(value) {
+  return typeof value === "string" && value === value.trim() && EMAIL_PATTERN.test(value);
+}
