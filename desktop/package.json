{
  "name": "hivemind-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.production.json && vite build",
    "bundle:prepare": "node scripts/prepare-bundle.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run bundle:stamp && tauri build --bundles nsis --config src-tauri/gen/version.conf.json",
    "test": "vitest run",
    "test:e2e:installed": "node e2e/installed-app.mjs",
    "replay:collect": "node tools/collect-replay.mjs",
    "tauri:build:linux": "tauri build --bundles deb,appimage",
    "tauri:build:mac": "tauri build --bundles app,dmg",
    "install:local": "node scripts/install-local.mjs",
    "ship": "npm run verify:advisories && npm run verify:reachable && npm run tauri:build && npm run install:local",
    "verify:advisories": "node scripts/audit-gate.mjs",
    "bundle:stamp": "node scripts/stamp-version.mjs",
    "verify:reachable": "node tools/check-reachable.mjs",
    "release:local": "node scripts/release-contained.mjs",
    "release:github": "node scripts/release-contained.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "selenium-webdriver": "^4.47.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
